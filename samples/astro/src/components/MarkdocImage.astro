---
interface Props {
    src: string;
    alt?: string;
    width: number;
    height: number;
    caption?: string;
}

const {src, alt = "", width, height, caption} = Astro.props;
---
<figure>
    <img src={src} alt={alt} width={width} height={height}/>
    {caption && <figcaption>{caption}</figcaption>}
</figure>
